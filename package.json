{
  "name": "codex-limit-monitor",
  "version": "1.0.2",
  "private": true,
  "description": "Desktop overlay for monitoring Codex limits across multiple ChatGPT workspaces.",
  "main": "main.js",
  "scripts": {
    "prestart": "npm run icons",
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "check": "node --check main.js && node --check preload.js && node --check src/renderer.js",
    "icons": "node scripts/build-icons.mjs",
    "predist": "npm run icons",
    "dist": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.codex.limitmonitor",
    "productName": "Codex Limit Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "build/icon-32.png",
      "package.json"
    ],
    "icon": "build/icon.png",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4"
  }
}
